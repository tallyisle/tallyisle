{
  "app-id": "com.tallyisle.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "tallyisle",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-download",
    "--filesystem=xdg-documents"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "tallyisle",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/tallyisle /app/bin",
        "cp -a bundle/. /app/tallyisle/",
        "chmod +x /app/tallyisle/tallyisle",
        "ln -sf /app/tallyisle/tallyisle /app/bin/tallyisle",
        "install -Dm644 com.tallyisle.app.desktop /app/share/applications/com.tallyisle.app.desktop",
        "install -Dm644 com.tallyisle.app.metainfo.xml /app/share/metainfo/com.tallyisle.app.metainfo.xml",
        "install -Dm644 com.tallyisle.app.mime.xml /app/share/mime/packages/com.tallyisle.app.mime.xml",
        "for s in 16 32 64 128 256 512; do install -Dm644 icons/app_icon_${s}.png /app/share/icons/hicolor/${s}x${s}/apps/com.tallyisle.app.png; done"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../../build/linux/x64/release/bundle",
          "dest": "bundle"
        },
        {
          "type": "dir",
          "path": "../../../macos/Runner/Assets.xcassets/AppIcon.appiconset",
          "dest": "icons"
        },
        {
          "type": "file",
          "path": "com.tallyisle.app.desktop"
        },
        {
          "type": "file",
          "path": "com.tallyisle.app.metainfo.xml"
        },
        {
          "type": "file",
          "path": "com.tallyisle.app.mime.xml"
        }
      ]
    }
  ]
}
